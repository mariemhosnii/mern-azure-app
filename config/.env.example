# Local settings only. This file is NOT uploaded to Azure (see .gitignore).
# On Azure, set MONGO_URI in the Web App settings instead.
PORT=5000

# Replace with YOUR Atlas connection string (Drivers -> Node.js), keep /mern-users before the "?"
MONGO_URI=mongodb+srv://<username>:<password>@<your-cluster>.mongodb.net/mern-users?retryWrites=true&w=majority
